GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
RETRIEVAL_MODE=dense
# Development-only recommendation pilot. Keep false in production until release approval.
ENABLE_RECOMMENDATIONS=false
FEEDBACK_FORM_URL=https://forms.gle/5McdABdSnigwwdNz5

# Optional shared completion statistics. Keep both credentials server-side.
# Initialize once on deployment day: python usage_stats.py init
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_actual_langsmith_api_key
LANGSMITH_PROJECT=pakistan-north-travel-ai-dev

# Anonymous demo policy. Counters are volatile, not per-person guarantees.
CHAT_REQUESTS_PER_WINDOW=3
TRIP_REQUESTS_PER_WINDOW=1
USAGE_WINDOW_SECONDS=3600
SUBMISSION_COOLDOWN_SECONDS=12
MAX_QUESTION_CHARS=700
MAX_CONCURRENT_WORKFLOWS=2
PROVIDER_BACKOFF_SECONDS=60

# Process-local application budgets, below the user-verified project quotas.
# Daily counters use America/Los_Angeles, including daylight saving time.
WORKFLOWS_PER_MINUTE=3
GENERATION_API_CALLS_PER_MINUTE=10
GENERATION_API_CALLS_PER_DAY=300
EMBEDDING_API_CALLS_PER_MINUTE=30
EMBEDDING_API_CALLS_PER_DAY=300
# Conservative local input-token estimates, not provider token measurements.
GENERATION_INPUT_TOKENS_PER_MINUTE=150000
EMBEDDING_INPUT_TOKENS_PER_MINUTE=20000
